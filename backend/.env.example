# ---------------------------------------------------------------------------
# FIELDZY backend environment. Copy to backend/.env and fill in what you have.
# This file is NEVER exposed to the React frontend or the browser.
# ---------------------------------------------------------------------------

# Google Gemini — used only by POST /field-health-summary, server-side.
# Without a key FIELDZY returns a deterministic local summary, clearly labelled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the optional trained artefacts live (relative to backend/models by default)
# FIELDZY_MODELS_DIR=/absolute/path/to/models
# FIELDZY_PLANT_MODEL_DIR=/absolute/path/to/fieldzy_savedmodel
# FIELDZY_PLANT_CLASS_NAMES=/absolute/path/to/class_names.json
# FIELDZY_SOUND_MODEL=/absolute/path/to/fieldzy_sound_model.pkl
# FIELDZY_YAMNET_DIR=/absolute/path/to/yamnet

# Fallback to the transparent screening engines when artefacts are missing.
# Set to 0 to make /predict-plant and /analyse-audio return 503 instead.
FIELDZY_ALLOW_SCREENING=1

# Default farm centre for weather when a field has no coordinates
FIELDZY_LAT=12.9716
FIELDZY_LON=77.5946

# Storage
# FIELDZY_DB_PATH=/absolute/path/to/fieldzy.db
